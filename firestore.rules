rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validPublicTestimonial() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'clientName', 'starRating', 'reviewText', 'weddingDate', 'category',
          'isFeatured', 'location', 'createdAt', 'status'
        ])
        && data.keys().hasOnly([
          'clientName', 'starRating', 'reviewText', 'weddingDate', 'category',
          'isFeatured', 'location', 'createdAt', 'status'
        ])
        && data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 80
        && data.starRating is int && data.starRating >= 1 && data.starRating <= 5
        && data.reviewText is string && data.reviewText.size() >= 10 && data.reviewText.size() <= 2000
        && data.weddingDate is string && data.weddingDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.category in ['mehendi', 'makeup', 'both']
        && data.location is string && data.location.size() >= 1 && data.location.size() <= 80
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.isFeatured == false
        && data.status == 'pending';
    }

    // inquiries can be created by anyone, but read/write only by admin
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // availability can be read by anyone, write only by admin
    match /availability/{dateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // portfolio, services, testimonials, blogs, settings can be read by anyone, write only by admin
    match /portfolio/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /testimonials/{testimonialId} {
      allow read: if isAdmin() || resource.data.status == 'approved';
      allow create: if isAdmin() || validPublicTestimonial();
      allow update, delete: if isAdmin();
    }
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin();
    }
  }
}
